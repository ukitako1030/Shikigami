{
  "name": "shikigami",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ukitako1030/Shikigami.git"
  },
  "type": "module",
  "description": "Dedicated browser and experimental desktop workspaces for AI agents on Windows",
  "scripts": {
    "start": "node src/desktop-launcher.mjs",
    "start:service": "node src/service.mjs --serve",
    "start:probe": "node src/probe.mjs",
    "start:desktop": "node src/desktop/service.mjs --start",
    "test": "node src/verify.mjs",
    "test:codex": "node scripts/verify-codex.mjs",
    "test:shared": "node scripts/verify-shared.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "inspect:panel": "node scripts/inspect-panel.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83"
  }
}
